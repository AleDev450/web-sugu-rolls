# Supabase — opcional para la web y el juego, OBLIGATORIO para el panel /admin.
#
# Sin estas variables:
#   · la web muestra el contenido de /src/data (productos, paquetes, testimonios)
#   · el juego guarda el récord en localStorage
#   · /admin avisa que falta conectar el backend
#
# Con ellas, el contenido se lee de la base de datos y se edita desde /admin.
# Copia este archivo como .env.local y rellena los valores de tu proyecto
# (Supabase -> Project Settings -> API).
#
# Antes de usar el panel, ejecuta en el SQL Editor y en este orden:
#   1. supabase/schema.sql      (usuarios, códigos del juego, ranking)
#   2. supabase/contenido.sql   (productos, paquetes, testimonios, ajustes)
# y márcate como administrador:
#   update public.profiles set is_admin = true
#   where id = (select id from auth.users where email = 'tu@correo.com');

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
