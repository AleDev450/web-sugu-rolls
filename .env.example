# Copia este archivo como .env.local y rellena los valores.
# Los tres salen de Supabase -> Settings -> API.

# Públicas: viajan al navegador, es correcto que se vean.
NEXT_PUBLIC_SUPABASE_URL=https://hbpwsyourvemjwbgqhgy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_qmU6s6jzcoILxiwCkxEdlQ_PembWJ5F

# SECRETA. Se salta todas las políticas de seguridad de la base, así que solo
# se usa en el servidor (/api/registro) y NUNCA lleva el prefijo NEXT_PUBLIC_.
#
# Sin ella, el alta de clientes cae al registro normal de Supabase: envía
# correo de confirmación, la cuenta no puede entrar hasta abrirlo, y a los
# pocos intentos se agota el límite de envíos del plan gratuito.
#
# Acuérdate de añadirla también en Vercel -> Settings -> Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
