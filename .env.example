# Copia este archivo como .env.local y rellena los valores.
# Los tres salen de Supabase -> Settings -> API.

# Públicas: viajan al navegador, es correcto que se vean.
NEXT_PUBLIC_SUPABASE_URL=...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=....

# SECRETA. Se salta todas las políticas de seguridad de la base, así que solo
# se usa en el servidor (/api/registro) y NUNCA lleva el prefijo NEXT_PUBLIC_.
#
# Sin ella, el alta de clientes cae al registro normal de Supabase: envía
# correo de confirmación, la cuenta no puede entrar hasta abrirlo, y a los
# pocos intentos se agota el límite de envíos del plan gratuito.
#
# Acuérdate de añadirla también en Vercel -> Settings -> Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=...

# ID de cliente de Google (OAuth 2.0, tipo "Aplicación web").
# Es PÚBLICO: identifica la app ante Google, no es un secreto.
# Sin él, el botón de Google cae al camino con redirección, que también
# funciona pero saca al cliente de la web.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=...

# Clave de la API de Google Maps (Google Cloud Console -> APIs y servicios ->
# Credenciales). Es PÚBLICA: se restringe por dominio (HTTP referrers) desde
# la misma consola, no por mantenerla en secreto.
#
# Habilita "Maps JavaScript API", "Places API" y "Distance Matrix API" en el
# proyecto de Google Cloud (piden una cuenta de facturación, aunque el uso
# normal de esta web no debería salir del nivel gratuito).
#
# Sin ella, el campo de dirección del checkout se queda como un input de
# texto normal: no hay autocompletado ni estimado de delivery, pero se puede
# seguir pidiendo igual.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=...
